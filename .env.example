# Shared secret for /api/cron/* (sent as x-cron-secret)
CRON_SECRET=generate_a_long_random_string

# ---- Market data ----
BINANCE_API_URL=https://api.binance.com

# ---- Risk ----
# Drawdown is measured and shown, but only fails an account / flattens positions when this is 1.
ENFORCE_DRAWDOWN_BREACH=0
