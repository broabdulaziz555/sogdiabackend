# ---- Market data ----
BINANCE_API_URL=https://api.binance.com

# ---- Risk ----
# Daily and max drawdown always fail an account and close its positions when equity touches the floor.
# RISK_ENGINE=off disables every automatic action (testing only).
# RISK_ENGINE=on
